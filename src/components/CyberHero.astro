---
import { site } from '../data/site';

const { postCount = 0 } = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy hero-card">
      <p class="hero-eyebrow" data-i18n-zh="赛博水族馆 / AI 工程博客 / 默认中文" data-i18n-en="Cyber Aquarium / AI Engineering Blog / EN Ready"><span></span>赛博水族馆 / AI 工程博客 / 默认中文</p>
      <h1 data-i18n-html data-i18n-zh="一条想飞的鱼，<br />把深海写成天空。" data-i18n-en="A flying fish,<br />turning deep water into sky.">一条想飞的鱼，<br />把深海写成天空。</h1>
      <p
        class="hero-desc"
        data-i18n-zh="这里不是普通文章列表，而是我的 AI 工程实验舱：记录智能体、RAG、多模态、工程自动化与长期学习路线。你可以从项目入口查看实践成果，也可以通过 GitHub 或邮箱联系我。"
        data-i18n-en="This is not a plain archive. It is my AI engineering cockpit for agents, RAG, multimodal systems, automation, and long-term learning paths. Start from projects, then dive into the notes."
      >
        这里不是普通文章列表，而是我的 AI 工程实验舱：记录智能体、RAG、多模态、工程自动化与长期学习路线。你可以从项目入口查看实践成果，也可以通过 GitHub 或邮箱联系我。
      </p>
      <div class="button-row">
        <a class="button primary" href="#projects" data-i18n-zh="查看项目" data-i18n-en="View projects">查看项目</a>
        <a class="button" href="/archive/" data-search-open data-i18n-zh="全局搜索" data-i18n-en="Global search">全局搜索</a>
        <a class="button" href={site.github} data-i18n-zh="GitHub 主页" data-i18n-en="GitHub">GitHub 主页</a>
      </div>
      <div class="signals" aria-label="站点统计">
        <div>
          <strong>{postCount}+</strong>
          <span data-i18n-zh="技术文章与笔记" data-i18n-en="technical posts">技术文章与笔记</span>
        </div>
        <div>
          <strong>AI</strong>
          <span data-i18n-zh="主线专题更新中" data-i18n-en="main track in progress">主线专题更新中</span>
        </div>
        <div>
          <strong>构建</strong>
          <span data-i18n-zh="项目驱动学习" data-i18n-en="project-led learning">项目驱动学习</span>
        </div>
      </div>
    </div>
    <div class="aquarium" aria-label="Flying fish holographic aquarium">
      <div class="aquarium-scene">
        <div class="camera-stage" aria-hidden="true">
          <div class="sky-stage">
            <span class="cyber-sun"></span>
            <span class="cloud cloud-a"></span>
            <span class="cloud cloud-b"></span>
            <span class="cloud cloud-c"></span>
            <span class="sky-scan"></span>
          </div>
          <div class="sea-surface">
            <span class="surface-glow"></span>
            <span class="surface-wave surface-wave-a"></span>
            <span class="surface-wave surface-wave-b"></span>
            <span class="splash-burst splash-out"></span>
            <span class="splash-burst splash-in"></span>
            <span class="water-drop water-drop-a"></span>
            <span class="water-drop water-drop-b"></span>
            <span class="water-drop water-drop-c"></span>
          </div>
          <div class="ocean-stage">
            <span class="water-light water-light-a"></span>
            <span class="water-light water-light-b"></span>
            <span class="water-current water-current-a"></span>
            <span class="water-current water-current-b"></span>
            <span class="bubble bubble-a"></span>
            <span class="bubble bubble-b"></span>
            <span class="bubble bubble-c"></span>
            <span class="bubble bubble-d"></span>
          </div>
        </div>

        <div class="fish-flight-path">
          <div class="orbit-system" aria-hidden="true">
            <span class="orbit-keyword orbit-java"><span>JAVA · SPRING</span></span>
            <span class="orbit-keyword orbit-typescript"><span>TYPESCRIPT · VUE</span></span>
            <span class="orbit-keyword orbit-python"><span>PYTHON · FASTAPI</span></span>
            <span class="orbit-keyword orbit-agent"><span>AGENT · RAG</span></span>
            <span class="orbit-keyword orbit-docker"><span>DOCKER · LINUX</span></span>
          </div>
          <div class="fish-artwork">
            <svg class="wing-echo wing-echo-a" viewBox="0 0 420 260" aria-hidden="true">
              <path d="M142 145C183 47 286 24 362 61C292 76 247 117 214 188C190 165 168 151 142 145Z" />
              <path d="M139 157C188 88 279 78 341 108C282 119 235 151 196 211C181 185 162 169 139 157Z" />
            </svg>
            <svg class="wing-echo wing-echo-b" viewBox="0 0 420 260" aria-hidden="true">
              <path d="M142 145C183 47 286 24 362 61C292 76 247 117 214 188C190 165 168 151 142 145Z" />
              <path d="M139 157C188 88 279 78 341 108C282 119 235 151 196 211C181 185 162 169 139 157Z" />
            </svg>
            <svg class="flying-fish" viewBox="0 0 420 260" role="img" aria-labelledby="flying-fish-title">
            <title id="flying-fish-title">一条展开鱼翼、从深海飞向天空的鱼</title>
            <defs>
              <linearGradient id="fish-body-gradient" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#e8fdff" />
                <stop offset="0.48" stop-color="#58dced" />
                <stop offset="1" stop-color="#6479df" />
              </linearGradient>
              <linearGradient id="fish-wing-gradient" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0" stop-color="#42dce9" stop-opacity=".24" />
                <stop offset="0.58" stop-color="#8c78e8" stop-opacity=".76" />
                <stop offset="1" stop-color="#ef78c9" stop-opacity=".94" />
              </linearGradient>
              <linearGradient id="fish-tail-gradient" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#6edfec" stop-opacity=".7" />
                <stop offset="1" stop-color="#ef78c9" stop-opacity=".9" />
              </linearGradient>
            </defs>
            <g class="fish-wing fish-wing-back">
              <path d="M142 145C183 47 286 24 362 61C292 76 247 117 214 188C190 165 168 151 142 145Z" />
              <path class="wing-vein" d="M165 137C220 111 272 83 330 68" />
              <path class="wing-vein" d="M183 151C232 137 270 119 307 92" />
            </g>
            <g class="fish-tail">
              <path d="M307 151L389 94L365 151L396 203L304 178Z" />
              <path class="tail-light" d="M321 157L372 118L357 154L376 184L320 170Z" />
            </g>
            <path class="fish-body" d="M48 158C112 102 219 100 321 156C242 218 120 219 48 158Z" />
            <path class="fish-back-light" d="M70 151C135 111 222 112 290 145" />
            <path class="fish-belly" d="M76 171C145 199 228 197 290 169" />
            <path class="fish-gill" d="M148 133C132 149 132 168 148 184" />
            <g class="fish-wing fish-wing-front">
              <path d="M139 157C188 88 279 78 341 108C282 119 235 151 196 211C181 185 162 169 139 157Z" />
              <path class="wing-vein" d="M165 160C213 137 256 123 313 113" />
            </g>
            <circle class="fish-eye" cx="112" cy="145" r="8" />
            <circle class="fish-eye-glint" cx="115" cy="142" r="2.4" />
            </svg>
          </div>
        </div>

        <div class="flight-trail" aria-hidden="true">
          <span class="trail-ribbon trail-ribbon-a"></span>
          <span class="trail-ribbon trail-ribbon-b"></span>
          <span class="trail-particle trail-particle-a"></span>
          <span class="trail-particle trail-particle-b"></span>
          <span class="trail-particle trail-particle-c"></span>
          <span class="trail-particle trail-particle-d"></span>
          <span class="trail-particle trail-particle-e"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 824px;
    padding: 40px 0 34px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 746px) minmax(360px, 526px);
    gap: 40px;
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 25px;
    min-height: 650px;
    align-content: center;
  }

  .hero-card {
    border: 1px solid rgb(40 247 255 / 20%);
    border-radius: 34px;
    padding: 44px 40px;
    background: var(--hero-background);
    box-shadow: 0 30px 80px rgb(0 0 0 / 38%), var(--shadow-glow);
  }

  .hero-eyebrow {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 9px;
    border: 1px solid rgb(40 247 255 / 32%);
    border-radius: 999px;
    margin: 0;
    padding: 8px 12px;
    background: rgb(8 47 73 / 20%);
    color: var(--color-cyan);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .hero-eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-magenta);
    box-shadow: 0 0 18px var(--color-magenta);
  }

  h1 {
    margin: 0;
    max-width: 760px;
    color: var(--hero-heading-start);
    background: linear-gradient(90deg, var(--hero-heading-start) 0%, var(--color-cyan) 48%, var(--color-magenta) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    font-size: clamp(4rem, 6.4vw, 4.75rem);
    line-height: 1.03;
    letter-spacing: 0;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    max-width: 680px;
    margin: 0;
    color: #b8c7d2;
    font-size: 1.06rem;
  }

  .signals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: 640px;
  }

  .signals div {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: 15px;
    background: var(--surface-soft);
  }

  .signals strong {
    display: block;
    color: var(--color-text);
    font-size: 1.8rem;
    line-height: 1;
  }

  .signals div:nth-child(2) strong {
    color: var(--color-cyan);
  }

  .signals div:nth-child(3) strong {
    color: var(--color-magenta);
  }

  .signals span {
    color: var(--color-muted);
    font-size: 0.76rem;
  }

  .aquarium {
    position: relative;
    min-height: 650px;
    overflow: hidden;
    border: 1px solid rgb(69 212 235 / 18%);
    border-radius: 30px;
    background: #dff5fb;
    box-shadow: inset 0 -90px 130px rgb(2 10 24 / 38%), 0 24px 70px rgb(13 64 94 / 22%);
    isolation: isolate;
  }

  .aquarium::before {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: linear-gradient(115deg, rgb(255 255 255 / 8%), transparent 28%, transparent 74%, rgb(236 112 205 / 8%));
    content: '';
    pointer-events: none;
  }

  .aquarium-scene,
  .flight-trail {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .camera-stage {
    position: absolute;
    inset: -30% 0 0;
    height: 130%;
    animation: camera-rise 14s cubic-bezier(.42, 0, .2, 1) infinite;
    will-change: transform;
  }

  .sky-stage {
    position: absolute;
    inset: 0 0 29%;
    overflow: hidden;
    background:
      radial-gradient(circle at 72% 24%, rgb(255 255 255 / 88%), transparent 15%),
      radial-gradient(circle at 70% 28%, rgb(222 121 212 / 18%), transparent 32%),
      linear-gradient(180deg, #fbfdff 0%, #e8f8fc 44%, #bfe7f1 78%, #88cfdf 100%);
  }

  .cyber-sun {
    position: absolute;
    top: 13%;
    right: 14%;
    width: 92px;
    height: 92px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 22%, rgb(113 222 238 / 46%) 44%, transparent 72%);
    box-shadow: 0 0 60px rgb(85 207 232 / 30%), 0 0 110px rgb(226 112 204 / 16%);
    animation: sun-breathe 7s ease-in-out infinite;
  }

  .cloud {
    position: absolute;
    width: 58%;
    height: 16%;
    border-radius: 999px;
    background: radial-gradient(ellipse, rgb(255 255 255 / 88%), rgb(225 244 249 / 48%) 54%, transparent 74%);
    filter: blur(9px);
    opacity: .74;
    animation: cloud-drift 18s ease-in-out infinite alternate;
  }

  .cloud-a { top: 24%; left: -19%; }
  .cloud-b { top: 44%; right: -24%; width: 72%; animation-delay: -7s; animation-duration: 24s; }
  .cloud-c { top: 62%; left: 8%; width: 46%; opacity: .46; animation-delay: -12s; }

  .sky-scan {
    position: absolute;
    top: -15%;
    left: 32%;
    width: 18%;
    height: 120%;
    background: linear-gradient(90deg, transparent, rgb(55 205 229 / 15%), transparent);
    filter: blur(8px);
    transform: rotate(12deg);
    animation: sky-scan 10s ease-in-out infinite;
  }

  .sea-surface {
    position: absolute;
    top: 68%;
    right: 0;
    left: 0;
    z-index: 3;
    height: 9%;
  }

  .surface-glow {
    position: absolute;
    inset: -65% -8%;
    background: radial-gradient(ellipse, rgb(236 254 255 / 90%), rgb(61 205 226 / 32%) 35%, transparent 68%);
    filter: blur(10px);
    animation: surface-glow 14s ease-in-out infinite;
  }

  .surface-wave {
    position: absolute;
    right: -10%;
    left: -10%;
    height: 52%;
    border-radius: 50%;
    background: linear-gradient(180deg, rgb(238 254 255 / 72%), rgb(61 195 219 / 24%), transparent);
    filter: blur(3px);
    animation: surface-wave 4.8s ease-in-out infinite alternate;
  }

  .surface-wave-a { top: 12%; }
  .surface-wave-b { top: 42%; left: -18%; opacity: .62; animation-delay: -2.4s; }

  .ocean-stage {
    position: absolute;
    top: 71%;
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 16% 22%, rgb(42 199 222 / 28%), transparent 38%),
      linear-gradient(180deg, #1684a5 0%, #0a526e 25%, #073752 54%, #06162a 100%);
  }

  .splash-burst {
    position: absolute;
    bottom: 34%;
    width: 28%;
    height: 92%;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 50% 100%, rgb(255 255 255 / 92%), transparent 34%),
      repeating-conic-gradient(from 210deg at 50% 100%, transparent 0deg 9deg, rgb(179 241 249 / 72%) 10deg 12deg, transparent 13deg 24deg);
    filter: drop-shadow(0 0 12px rgb(79 213 233 / 48%));
    opacity: 0;
    transform-origin: 50% 100%;
  }

  .splash-out { left: 28%; animation: splash-break 14s ease-out infinite; }
  .splash-in { right: 7%; animation: splash-return 14s ease-out infinite; }

  .water-drop {
    position: absolute;
    bottom: 48%;
    left: 39%;
    width: 7px;
    height: 12px;
    border-radius: 60% 60% 70% 70%;
    background: rgb(226 252 255 / 90%);
    box-shadow: 0 0 10px rgb(74 211 232 / 70%);
    opacity: 0;
    animation: water-drop-flight 14s ease-in infinite;
  }

  .water-drop-b { left: 33%; width: 5px; height: 9px; animation-delay: .24s; }
  .water-drop-c { left: 45%; width: 4px; height: 7px; animation-delay: .48s; }

  .water-light {
    position: absolute;
    width: 76%;
    height: 56%;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgb(83 218 237 / 20%), transparent 68%);
    filter: blur(25px);
    animation: current-drift 9s ease-in-out infinite alternate;
  }

  .water-light-a {
    bottom: -18%;
    left: -20%;
  }

  .water-light-b {
    top: -8%;
    right: -25%;
    background: radial-gradient(ellipse, rgb(224 106 202 / 18%), transparent 70%);
    animation-delay: -4s;
    animation-duration: 13s;
  }

  .water-current {
    position: absolute;
    width: 120%;
    height: 42%;
    border-radius: 50%;
    background: linear-gradient(110deg, transparent 32%, rgb(130 229 240 / 6%) 48%, transparent 64%);
    filter: blur(12px);
    transform: rotate(-16deg);
    animation: water-sweep 11s ease-in-out infinite;
  }

  .water-current-a {
    top: 12%;
    left: -42%;
  }

  .water-current-b {
    right: -52%;
    bottom: 4%;
    animation-delay: -6s;
    animation-duration: 15s;
  }

  .bubble,
  .trail-particle {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(184 245 255 / 74%);
    box-shadow: 0 0 12px rgb(83 220 239 / 68%);
  }

  .bubble {
    bottom: -12%;
    animation: bubble-rise 8s linear infinite;
  }

  .bubble-a {
    left: 14%;
    animation-delay: -2s;
  }

  .bubble-b {
    left: 33%;
    width: 8px;
    height: 8px;
    animation-delay: -6s;
    animation-duration: 11s;
  }

  .bubble-c {
    left: 70%;
    width: 4px;
    height: 4px;
    animation-delay: -4s;
    animation-duration: 9s;
  }

  .bubble-d {
    left: 86%;
    width: 7px;
    height: 7px;
    animation-delay: -8s;
    animation-duration: 13s;
  }

  .fish-flight-path {
    position: absolute;
    bottom: 5%;
    left: 0;
    z-index: 6;
    width: 66%;
    animation: fish-flight 14s cubic-bezier(.42, 0, .2, 1) infinite;
    will-change: transform, opacity;
  }

  .flying-fish {
    display: block;
    width: 100%;
    overflow: visible;
    filter: drop-shadow(0 18px 20px rgb(1 12 27 / 32%)) drop-shadow(0 0 22px rgb(69 218 236 / 28%));
  }

  .fish-artwork {
    position: relative;
    width: 100%;
    transform: scaleX(-1);
    transform-origin: center;
  }

  .wing-echo {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    overflow: visible;
    opacity: 0;
    filter: blur(2px) drop-shadow(0 0 18px rgb(132 109 232 / 28%));
    animation: wing-echo-flight 14s ease-out infinite;
    pointer-events: none;
  }

  .wing-echo path {
    fill: url(#fish-wing-gradient);
    stroke: rgb(152 219 241 / 46%);
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .wing-echo-b {
    animation-delay: .16s;
    filter: blur(3px) drop-shadow(0 0 22px rgb(226 105 204 / 22%));
  }

  .fish-body {
    fill: url(#fish-body-gradient);
    stroke: rgb(220 251 255 / 84%);
    stroke-linejoin: round;
    stroke-width: 3;
  }

  .fish-back-light,
  .fish-belly,
  .fish-gill {
    fill: none;
    stroke-linecap: round;
  }

  .fish-back-light {
    stroke: rgb(255 255 255 / 68%);
    stroke-width: 4;
  }

  .fish-belly,
  .fish-gill {
    stroke: rgb(26 82 124 / 58%);
    stroke-width: 3;
  }

  .fish-wing {
    transform-box: fill-box;
    transform-origin: 18% 72%;
    animation: wing-glide 14s ease-in-out infinite;
  }

  .fish-wing path {
    fill: url(#fish-wing-gradient);
    stroke: rgb(174 235 246 / 76%);
    stroke-linejoin: round;
    stroke-width: 3;
  }

  .fish-wing-front {
    animation-delay: -.18s;
  }

  .fish-tail {
    transform-box: fill-box;
    transform-origin: left center;
    animation: tail-swim 1.1s ease-in-out infinite;
  }

  .fish-tail > path:first-child {
    fill: url(#fish-tail-gradient);
    stroke: rgb(177 232 245 / 72%);
    stroke-linejoin: round;
    stroke-width: 3;
  }

  .wing-vein,
  .tail-light {
    fill: none !important;
    stroke: rgb(231 250 255 / 48%) !important;
    stroke-linecap: round;
    stroke-width: 2 !important;
  }

  .fish-eye {
    fill: #09213b;
    stroke: rgb(225 252 255 / 86%);
    stroke-width: 2;
  }

  .fish-eye-glint {
    fill: #fff;
  }

  .orbit-system {
    position: absolute;
    inset: -6% -10%;
    z-index: 8;
    transform: none;
    pointer-events: none;
    animation: orbit-visibility 14s ease-in-out infinite;
  }

  .orbit-keyword {
    position: absolute;
    inset: 9% 0;
    transform: rotate(0deg) scaleY(.58);
    animation: keyword-orbit 9s linear infinite;
  }

  .orbit-keyword > span {
    position: absolute;
    top: 50%;
    right: -4%;
    border-radius: 999px;
    padding: 5px 9px;
    background: rgb(242 252 255 / 72%);
    box-shadow: 0 6px 20px rgb(31 119 157 / 14%), 0 0 18px rgb(210 104 194 / 15%);
    color: #245a70;
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .12em;
    white-space: nowrap;
    transform: translateY(-50%) scaleY(1.72);
    animation: keyword-counter-rotate 9s linear infinite, keyword-depth 4.5s ease-in-out infinite;
  }

  .orbit-typescript { animation-delay: -3s; }
  .orbit-typescript > span { animation-delay: -3s, -1.5s; }
  .orbit-python { animation-delay: -6s; }
  .orbit-python > span { animation-delay: -6s, -3s; }
  .orbit-agent { inset: 21% 12%; animation-delay: -1.5s; }
  .orbit-agent > span { animation-delay: -1.5s, -.75s; }
  .orbit-docker { inset: 21% 12%; animation-delay: -4.5s; }
  .orbit-docker > span { animation-delay: -4.5s, -2.25s; }

  .flight-trail {
    z-index: 2;
    overflow: visible;
    pointer-events: none;
  }

  .trail-ribbon {
    position: absolute;
    bottom: 24%;
    left: 8%;
    width: 38%;
    height: 70px;
    border-radius: 50%;
    background: linear-gradient(100deg, transparent, rgb(69 218 236 / 22%), transparent 76%);
    filter: blur(16px);
    opacity: 0;
    transform: rotate(-22deg);
    animation: ribbon-pulse 14s ease-out infinite;
  }

  .trail-ribbon-b {
    bottom: 34%;
    left: 19%;
    background: linear-gradient(100deg, transparent, rgb(227 105 203 / 16%), transparent 76%);
    animation-delay: .45s;
  }

  .trail-particle {
    opacity: 0;
    animation: trail-drift 14s ease-out infinite;
  }

  .trail-particle-a { bottom: 30%; left: 20%; }
  .trail-particle-b { bottom: 35%; left: 29%; animation-delay: .45s; }
  .trail-particle-c { bottom: 43%; left: 37%; width: 8px; height: 8px; animation-delay: .9s; }
  .trail-particle-d { bottom: 49%; left: 45%; animation-delay: 1.25s; }
  .trail-particle-e { bottom: 56%; left: 54%; width: 3px; height: 3px; animation-delay: 1.65s; }

  @keyframes fish-flight {
    0% { opacity: 0; transform: translate(-30%, 62%) rotate(-5deg) scale(.64); }
